// dstoolkit Prisma schema (MySQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum MsgRole {
  USER
  ASSISTANT
}

// ═══════════ AI 知识库扩展 ═══════════

// 统一对话来源
enum ConversationSource {
  DEEPSEEK_SHARE   // DeepSeek 分享链接增量导入
  OPENAI_SHARE     // OpenAI/ChatGPT 分享链接增量导入
  DEEPSEEK_JSON    // DeepSeek 消息 JSON 全量导入
  OPENAI_JSON      // OpenAI 消息 JSON 全量导入
  CONTINUED        // 续聊生成（DeepSeek 内置）
  AGENT            // Agent 续聊生成（StepFun 内置）
}

// 统一消息角色
enum UnifiedMsgRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

// 试卷题目类型
enum QuestionType {
  SINGLE_CHOICE     // 单选题
  MULTIPLE_CHOICE   // 多选题
  TRUE_FALSE        // 判断题
  FILL_BLANK        // 填空题
  SHORT_ANSWER      // 简答题
}

// 试卷状态
enum TestPaperStatus {
  GENERATING
  READY
  FAILED
}

// MCP 传输类型
enum McpTransport {
  HTTP
  STDIO
}

// ═══════════ 订阅等级 ═══════════
enum Tier {
  FREE
  PRO
  PLUS
  ULTIMATE
  TEAM
}

enum CardDuration {
  PERMANENT
  ANNUAL
}

enum CardStatus {
  UNUSED
  USED
  REVOKED
}

enum CardSource {
  LOCAL
  KUFAKA
}

// 注册方式：LEGACY=存量用户（云权限保留）；USERNAME_PASSWORD=新传统注册（需绑手机才可用云端）；PHONE=手机号验证码/一键登录注册
enum RegistrationType {
  LEGACY
  USERNAME_PASSWORD
  PHONE
}

model User {
  id               Int              @id @default(autoincrement())
  username         String           @unique
  passwordHash     String
  role             Role             @default(USER)
  cloudSyncEnabled Boolean          @default(false)

  // 手机号绑定（验证码登录/一键登录注册的用户默认已验证）
  phone            String?          @unique
  phoneVerifiedAt  DateTime?
  registrationType RegistrationType @default(LEGACY)

  // Git 生态：Git 推送专用用户名（英文+数字+下划线；username 含中文时必填）
  gitUsername      String?          @unique

  // 订阅等级
  tier             Tier             @default(FREE)
  tierActivatedAt  DateTime?
  tierExpiresAt    DateTime?
  isPermanentTier  Boolean          @default(false)

  // AI 积分余额（摘要/整理/导出等增值操作消耗）
  aiCredits        Int              @default(0)

  // 邀请返佣
  referralCode     String?          @unique
  referredById     Int?             // 邀请人 userId
  referredBy       User?             @relation("Referral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]            @relation("Referral")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  configs          DeepseekConfig[]
  apiKeys          ApiKey[]
  apiTokens        ApiToken[]
  gitApiKeys       GitApiKey[]
  redeemedCards    RedeemCard[]
  summaries        ConvSummary[]
  knowledgeCards   KnowledgeCard[]
  folders          Folder[]
  tags             ConvTag[]
  searchQueries    SearchQuery[]
  quotaLedger      QuotaLedger[]
  referralLinks    ReferralLink[]
  referralRewards  ReferralReward[]
  shares           Share[]
  oauthCodes       OAuthCode[]
  oauthTokens      OAuthToken[]
  oauthClients     OAuthClient[]

  // AI 知识库扩展
  unifiedConversations UnifiedConversation[]
  testPapers       TestPaper[]
  skills           Skill[]
  mcpServers       McpServer[]

  @@index([role])
  @@index([tier])
  @@index([referralCode])
}

model DeepseekConfig {
  id             Int           @id @default(autoincrement())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  name           String
  deepseekUserId String
  deepseekEmail  String?       @db.Text
  deepseekMobile String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  conversations  Conversation[]
  shares         Share[]
  gitApiKeys     GitApiKey[]

  // 同一 DeepSeek 账号允许建多个容器（每个容器独立 Git 仓库 u<uid>_c<cid>.git）
  @@index([userId, deepseekUserId])
}

model Conversation {
  id             Int       @id @default(autoincrement())
  config          DeepseekConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId        Int
  deepseekConvId  String
  title           String    @db.Text
  insertedAt      DateTime
  updatedAt       DateTime
  rawMapping      Json
  turnCount       Int       @default(0)
  messages        Message[]

  // AI 摘要与知识卡片
  summary         ConvSummary?
  knowledgeCards  KnowledgeCard[]

  // 文件夹/标签关联
  folderItems     ConversationTag[]

  @@unique([configId, deepseekConvId])
  @@index([configId])
  @@index([insertedAt])
}

model Message {
  id             Int        @id @default(autoincrement())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  Int
  nodeId          String
  parentId        String?
  role            MsgRole
  model           String?
  content         String     @db.LongText
  insertedAt      DateTime
  turnIndex       Int?
  versionIndex    Int?
  subTurnIndex    Int?

  @@index([conversationId])
  @@index([role])
  @@index([turnIndex])
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  name      String
  keyCipher String   @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model AppMarketEntry {
  id          Int      @id @default(autoincrement())
  name        String
  url         String   @db.Text
  description String?  @db.Text
  category    String   @default("official")
  createdAt   DateTime @default(now())

  @@index([category])
}

// Git 生态推送/拉取凭证：Basic Auth 用（username=GitUsername, password=dstkg_ 明文）
// containerId 为空 = 全局 key（可访问该用户全部对话容器仓库，安全性略低）
model GitApiKey {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  container   DeepseekConfig? @relation(fields: [containerId], references: [id], onDelete: Cascade)
  containerId Int?
  name        String
  keyHash     String    @unique // SHA-256(明文)，不存明文
  prefix      String    // dstkg_xxxx 掩码展示用
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([containerId])
}

// dstoolkit RESTful API 访问令牌（区别于 ApiKey：ApiKey 存储用户的 Deepseek 密钥）
model ApiToken {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?

  @@index([userId])
}

// ═══════════ 卡密兑换 ═══════════
model RedeemCard {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  tier        Tier
  duration    CardDuration
  source      CardSource    @default(LOCAL)
  status      CardStatus    @default(UNUSED)
  usedBy      User?          @relation(fields: [usedById], references: [id], onDelete: SetNull)
  usedById    Int?
  redeemedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([tier])
  @@index([status])
}

// ═══════════ UX-F1: AI 摘要 + 知识卡片 ═══════════
model ConvSummary {
  id              Int           @id @default(autoincrement())
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  Int           @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  tldr            String        @db.Text   // TL;DR 一句话摘要
  summary         String        @db.Text   // 详细摘要
  tags            Json          // 主题标签数组 ["React","性能优化"]
  confidence      Float         @default(0.8) // AI 置信度 0-1
  model           String?       // 生成所用模型
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model KnowledgeCard {
  id              Int           @id @default(autoincrement())
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  title           String        // 卡片标题
  content         String        @db.Text  // 卡片内容
  category        String?       // 分类
  tags            Json          // 标签数组
  sourceNodeId    String?       // 来源消息 nodeId
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([conversationId])
  @@index([category])
}

// ═══════════ UX-F3: 文件夹 + 标签 ═══════════
model Folder {
  id          Int              @id @default(autoincrement())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  name        String
  color       String?          // 文件夹颜色
  icon        String?          // 图标标识
  parentId    Int?             // 支持嵌套
  parent      Folder?          @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Folder[]         @relation("FolderTree")
  items       ConversationTag[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([parentId])
}

model ConvTag {
  id          Int              @id @default(autoincrement())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  name        String
  color       String?
  createdAt   DateTime         @default(now())
  items       ConversationTag[]

  @@unique([userId, name])
  @@index([userId])
}

// 对话与文件夹/标签的多对多关联
model ConversationTag {
  id              Int           @id @default(autoincrement())
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  Int
  folder          Folder?       @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId        Int?
  tag             ConvTag?      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId           Int?
  createdAt       DateTime      @default(now())

  @@index([conversationId])
  @@index([folderId])
  @@index([tagId])
}

// ═══════════ UX-F2: 搜索行为记录 ═══════════
model SearchQuery {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  query       String   @db.Text
  resultCount Int      @default(0)
  clickedConvId String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ═══════════ MKT-M1/M4: AI 积分流水 ═══════════
model QuotaLedger {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  action      String   // SUMMARY / KNOWLEDGE_CARD / AI_ORGANIZE / EXPORT / TOPUP / REFERRAL / MONTHLY_GRANT
  delta       Int      // 正数=获得，负数=消耗
  balance     Int      // 操作后余额快照
  detail      String?  @db.Text  // 附加说明
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ═══════════ MKT-M5: 邀请返佣 ═══════════
model ReferralLink {
  id                    Int      @id @default(autoincrement())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                Int
  code                  String   @unique  // 短码
  clicks                Int      @default(0)
  signupCount           Int      @default(0)
  totalCommissionEarned Int      @default(0)  // 单位：积分
  createdAt             DateTime @default(now())

  @@index([userId])
}

model ReferralReward {
  id          Int      @id @default(autoincrement())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  type        String   // SIGNUP / FIRST_SUBSCRIBE / PURCHASE
  refereeId   Int?     // 被邀请人 userId
  credits     Int      // 获得积分数
  detail      String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([refereeId])
}

// ═══════════ OAuth2.0（App/插件授权码 + PKCE） ═══════════
model OAuthClient {
  id           Int           @id @default(autoincrement())
  clientId     String        @unique
  name         String
  redirectUris Json          // ["dstoolkit://oauth-callback", ...]
  scopes       Json          // ["read:conversations", ...]
  isPublic     Boolean       @default(true) // true = PKCE 公共客户端，无 client_secret
  enabled      Boolean       @default(true)
  // 开放平台：开发者自有的 OAuth 应用（内置公共客户端 userId 为 null）
  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      Int?
  createdAt    DateTime      @default(now())
  codes        OAuthCode[]
  tokens       OAuthToken[]

  @@index([ownerId])
}

model OAuthCode {
  id                  Int          @id @default(autoincrement())
  codeHash            String       @unique // SHA256(code)，明文不落库
  clientId            Int
  client              OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId              Int
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes              Json
  redirectUri         String       @db.Text
  codeChallenge       String       @db.Text // PKCE S256
  codeChallengeMethod String       @default("S256")
  expiresAt           DateTime // 10 分钟
  used                Boolean      @default(false)
  createdAt           DateTime     @default(now())

  @@index([userId])
}

model OAuthToken {
  id              Int          @id @default(autoincrement())
  accessHash      String       @unique // SHA256(dstk_ token)，与 ApiToken.tokenHash 同值
  refreshHash     String?      @unique // SHA256(refresh_token)
  clientId        Int
  client          OAuthClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiTokenId      Int // 关联 ApiToken 行，revoke 时联动删除
  scopes          Json
  accessExpiresAt DateTime // 30 天
  refreshExpiresAt DateTime? // 60 天
  createdAt       DateTime     @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
  @@index([apiTokenId])
}

// ═══════════ 公开分享 ═══════════
model Share {
  id              Int       @id @default(autoincrement())
  slug            String    @unique       // 短链标识
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  config          DeepseekConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  configId        Int
  deepseekConvId  String                   // 冗余存储便于直接定位会话
  title           String     @db.Text
  theme           String     @default("default")
  passwordHash    String?    @db.Text       // 可选密码哈希
  viewCount       Int        @default(0)
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())

  @@index([userId])
  @@index([configId])
  @@index([createdAt])
}

// ═══════════ AI 知识库：统一对话（跨平台导入 + 续聊 + Agent） ═══════════
model UnifiedConversation {
  id          Int                @id @default(autoincrement())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  title       String             @db.Text
  source      ConversationSource
  sourceUrl   String?            @db.Text  // 分享链接原始 URL（导入来源）
  sourceConvId String?           // 原始平台会话 ID
  model       String?            // 续聊/Agent 所用模型
  turnCount   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  messages    UnifiedMessage[]

  @@index([userId])
  @@index([source])
  @@index([createdAt])
}

model UnifiedMessage {
  id              Int               @id @default(autoincrement())
  conversation    UnifiedConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId  Int
  role            UnifiedMsgRole
  content         String            @db.LongText
  model           String?
  toolName        String?           // TOOL 角色时的工具名
  toolCallId      String?           // tool_call 的 id
  toolCalls       Json?             // assistant 发起的 tool_calls（OpenAI 兼容格式）
  insertedAt      DateTime          @default(now())

  @@index([conversationId])
  @@index([role])
}

// ═══════════ AI 记忆：试卷与题目 ═══════════
model TestPaper {
  id              Int               @id @default(autoincrement())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  title           String            @db.Text
  description     String?           @db.Text
  subject         String?           // 学科/主题
  difficulty      String            @default("medium") // easy / medium / hard
  questionCount   Int               @default(0)
  totalScore      Int               @default(0)
  status          TestPaperStatus   @default(GENERATING)
  // 生成试卷时检索的知识范围：对话 ID 列表或关键词
  scope           Json?             // { conversationIds?: number[], keywords?: string[] }
  errorMessage    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  questions       TestPaperQuestion[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TestPaperQuestion {
  id              Int               @id @default(autoincrement())
  testPaper       TestPaper         @relation(fields: [testPaperId], references: [id], onDelete: Cascade)
  testPaperId     Int
  orderIndex      Int               @default(0)
  type            QuestionType
  content         String            @db.Text   // 题干
  options         Json?             // 选择题选项 [{key, text}]
  answer          Json              // 参考答案（单选: "A"；多选: ["A","C"]；判断: true；填空: ["答案1","答案2"]；简答: "..."）
  explanation     String?           @db.Text   // 答案解析
  score           Int               @default(0)
  // 关联的知识来源（可选）：来自哪段对话/哪个知识点
  sourceConvId    Int?
  sourceSnippet   String?           @db.Text

  @@index([testPaperId])
  @@index([type])
}

// ═══════════ Agent：Skill.md 技能库 ═══════════
model Skill {
  id              Int               @id @default(autoincrement())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  name            String
  description     String?           @db.Text
  content         String            @db.LongText  // Skill.md 完整内容
  tags            Json?             // 标签数组
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// ═══════════ Agent：MCP 服务器配置 ═══════════
model McpServer {
  id              Int               @id @default(autoincrement())
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  name            String
  description     String?           @db.Text
  transport       McpTransport      @default(HTTP)
  url             String?           @db.Text  // HTTP 模式的 endpoint
  command         String?           // STDIO 模式的启动命令
  args            Json?             // STDIO 模式的启动参数
  env             Json?             // 环境变量
  headers         Json?             // HTTP 模式的自定义头
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, name])
  @@index([userId])
}
